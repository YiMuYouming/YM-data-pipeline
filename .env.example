# Optional WenCai OpenAPI authentication.
IWENCAI_API_KEY=

# Optional explicit pywencai interpreter. When unset, the current interpreter
# and then the project-managed runtime are checked.
YM_PYWENCAI_PYTHON=

# Successful OpenAPI result cache, in seconds (0-1800).
IWENCAI_QUERY_CACHE_TTL=300

# StockToday local request budget (REPAIR_PLAN 2026-09-27). Vendor cap is
# 100/min and 20000/day; local and Hermes together stay below it.
YM_STOCKTODAY_PER_MINUTE=80
YM_STOCKTODAY_PER_DAY=18000
